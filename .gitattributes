# 1. Handle line endings for standard text files (code)
* text=auto eol=lf

# 2. Force Unity YAML files to be treated as text but WITHOUT normalization
# This prevents the "always modified" bug for TMP assets, Prefabs, and Scenes
*.asset -text
*.unity -text
*.prefab -text
*.mat -text
*.controller -text
*.overrideController -text
*.physicMaterial -text
*.physicsMaterial2D -text
*.playable -text
*.mask -text
*.terrainlayer -text
*.guiskin -text
*.fontsettings -text

# 3. Git LFS for Large/Binary Files
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text